*.hdf5
*.parquet

# ── Secrets ────────────────────────────────────────────
.env
*.key
*.pem
secrets/

# ── Results databases (can be large) ──────────────────
results/raw/*.db
results/raw/*.sqlite

# ── Logs ───────────────────────────────────────────────
*.log
logs/

# ── Local config overrides ─────────────────────────────
configs/local_*.yaml
configs/local_*.json

# ── Generated reports ─────────────────────────────────
docs/report/*.pdf
docs/report/*.docx

# University template (contains personal data)
Report_Template*.docx
