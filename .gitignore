# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
dist/
build/

# ── Virtual environments ───────────────────────────────
venv/
.venv/
env/
ENV/

# ── IDE & editors ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── OS files ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ────────────────────────────────────────────
.ipynb_checkpoints/

# ── Testing ────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Model weights (NEVER commit) ──────────────────────
*.gguf
*.bin
*.safetensors
*.onnx
*.pt
*.pth
models_cache/
model_downloads/

# ── Large data ─────────────────────────────────────────
